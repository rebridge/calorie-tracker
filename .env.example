# Copy to .env (git-ignored) on the machine that runs the container:
#   cp .env.example .env

# Required. The server refuses to start without it.
ANTHROPIC_API_KEY=

# Optional. Sets the day boundary and meal-type guess (an IANA time zone name).
# TZ=America/New_York

# Optional. Address and port the host listens on.
# Keep 127.0.0.1 when `tailscale serve` fronts the app; use 0.0.0.0 for your LAN
# or the host's Tailscale IP (tailscale ip -4) for the tailnet only.
# CALORIES_BIND=127.0.0.1
# CALORIES_PORT=8080
